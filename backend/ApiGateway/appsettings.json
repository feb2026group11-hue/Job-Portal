{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8080"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-service",
        "Match": {
          "Path": "api/auth/{**remainder}"
        }
      },
      "users-route": {
        "ClusterId": "auth-service",
        "Match": {
          "Path": "api/users/{**remainder}"
        }
      },
      "jobs-route": {
        "ClusterId": "job-service",
        "Match": {
          "Path": "api/jobs/{**remainder}"
        }
      },
      "profile-route": {
        "ClusterId": "job-service",
        "Match": {
          "Path": "api/profile/{**remainder}"
        }
      },
      "skills-route": {
        "ClusterId": "job-service",
        "Match": {
          "Path": "api/skills/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "job-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082/"
          }
        }
      }
    }
  }
}
