{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/user/{**catch-all}"
        }
      },
      "api_auth_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "api_users_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "candidate_profile_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/candidate-profile/{**catch-all}"
        }
      },
      "candidate_profile_base_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/candidate-profile"
        }
      },
      "education_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/education/{**catch-all}"
        }
      },
      "education_base_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/education"
        }
      },
      "api_profile_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "api_companies_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/companies/{**catch-all}"
        }
      },
      "api_skills_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/skills/{**catch-all}"
        }
      },
      "api_candidate_skills_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/candidate-skills/{**catch-all}"
        }
      },
      "api_projects_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "api_certificates_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/certificates/{**catch-all}"
        }
      },
      "api_resume_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/candidate/resume/{**catch-all}"
        }
      },
      "api_resume_base_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/candidate/resume"
        }
      },
      "api_candidate_me_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/candidate/me/{**catch-all}"
        }
      },
      "api_experiences_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/experiences/{**catch-all}"
        }
      },
      "api_employers_route": {
        "ClusterId": "employer_cluster",
        "Match": {
          "Path": "/api/employers/{**catch-all}"
        }
      },
      "api_jobs_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/jobs/{**catch-all}"
        }
      },
      "api_applications_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/applications/{**catch-all}"
        }
      },
      "api_job_status_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/job-status/{**catch-all}"
        }
      },
      "api_messages_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/messages/{**catch-all}"
        }
      },
      "api_states_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/states/{**catch-all}"
        }
      },
      "api_cities_route": {
        "ClusterId": "job_cluster",
        "Match": {
          "Path": "/api/cities/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_service": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "candidate_cluster": {
        "Destinations": {
          "candidate_service": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "employer_cluster": {
        "Destinations": {
          "employer_service": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "job_cluster": {
        "Destinations": {
          "job_service": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  }
}