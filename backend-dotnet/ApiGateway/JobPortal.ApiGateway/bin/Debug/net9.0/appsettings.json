{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/user/{**catch-all}"
        }
      },
      "candidate_profile_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/candidate-profile/{**catch-all}"
        }
      },
      "candidate_profile_base_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/candidate-profile"
        }
      },
      "education_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/education/{**catch-all}"
        }
      },
      "education_base_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/education"
        }
      },
      "api_route": {
        "ClusterId": "candidate_cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_service": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "candidate_cluster": {
        "Destinations": {
          "candidate_service": {
            "Address": "http://localhost:8082/"
          }
        }
      }
    }
  }
}
