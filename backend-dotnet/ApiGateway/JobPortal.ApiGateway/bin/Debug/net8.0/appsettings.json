{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/user/{**catch-all}"
        }
      },
      "employer_route": {
        "ClusterId": "employer_cluster",
        "Match": {
          "Path": "/api/employers/{**catch-all}"
        }
      },
      "jobs_route": {
        "ClusterId": "job_application_cluster",
        "Match": {
          "Path": "/api/jobs/{**catch-all}"
        }
      },
      "applications_route": {
        "ClusterId": "job_application_cluster",
        "Match": {
          "Path": "/api/applications/{**catch-all}"
        }
      },
      "messages_route": {
        "ClusterId": "job_application_cluster",
        "Match": {
          "Path": "/api/messages/{**catch-all}"
        }
      },
      "states_route": {
        "ClusterId": "job_application_cluster",
        "Match": {
          "Path": "/api/states/{**catch-all}"
        }
      },
      "cities_route": {
        "ClusterId": "job_application_cluster",
        "Match": {
          "Path": "/api/cities/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_service": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "employer_cluster": {
        "Destinations": {
          "employer_service": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "job_application_cluster": {
        "Destinations": {
          "job_application_service": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  }
}